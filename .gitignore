# Data: downloaded, processed and served files are rebuilt by the pipeline (tens of GB).
# Only the hand-written overrides are tracked.
/data/*
!/data/manual/

# ML: trained bundles, caches, staging and generated reports are rebuilt by f1ml.
/ml/models/
/ml/cache/
/ml/staging/
/ml/reports/
/ml_cand/

/logs/
/research/scratch/

# Python
__pycache__/
*.py[oc]
.venv/
.pytest_cache/

# Secrets and local settings
.env
.env.*
!.env.example
*.pem

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
/site/.qa/
/.wrangler/
